# Copy to .env and fill in. Never commit .env.

# ---- Database ----------------------------------------------------------------
# mssql (SQL Server 2022 via ODBC Driver 18) or duckdb (single local file)
DB_BACKEND=mssql
DB_HOST=localhost
DB_PORT=1433
DB_NAME=iris
# Admin login: used only by scripts/load_mssql.py to create schema, load data, RLS
MSSQL_SA_USER=sa
MSSQL_SA_PASSWORD=change-me-Str0ng
# Least-privilege login used by the app (SELECT only, subject to row-level security)
MSSQL_APP_USER=iris_reader
MSSQL_APP_PASSWORD=change-me-Reader1
ODBC_DRIVER=ODBC Driver 18 for SQL Server
# Dev only: the SQL Server container uses a self-signed certificate
MSSQL_TRUST_SERVER_CERT=yes
DUCKDB_PATH=data/iris.duckdb
# compose = start SQL Server with docker compose; external = DB already running elsewhere
DB_UP_MODE=compose

# ---- LLM (LiteLLM model string) ---------------------------------------------
LLM_MODEL=ollama/qwen2.5-coder:14b
OLLAMA_API_BASE=http://localhost:11434
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=300
# Optional comma-separated list shown in the UI model selector
LLM_MODEL_CHOICES=ollama/qwen2.5-coder:14b,ollama/llama3.1:8b,ollama/gpt-oss:20b,gemini/gemini-2.5-flash,groq/llama-3.3-70b-versatile,openrouter/meta-llama/llama-3.3-70b-instruct:free

# Hosted free-tier keys (only needed for the matching LLM_MODEL)
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
# Vertex AI (optional, uses Application Default Credentials instead of a key)
VERTEXAI_PROJECT=
VERTEXAI_LOCATION=us-central1

# ---- App ---------------------------------------------------------------------
# Overrides config/settings.yaml as_of_date if set (YYYY-MM-DD)
AS_OF_DATE=
DEFAULT_USER=group_cfo

# ---- Sign-in and conversation history (demo only; production would use SSO) --------
# Shared access code for the demo sign-in (display name + code). Required: nobody can sign in until it is set.
APP_ACCESS_CODE=
# SQL Server keeps history in the [app] schema; set APP_HISTORY_BACKEND=sqlite to use a local file instead
APP_HISTORY_BACKEND=
APP_HISTORY_DB=data/app_history.sqlite
