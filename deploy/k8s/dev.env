# .env for the dev pod (rendered by `make k8s-env`). Passwords are NOT stored here: the pod gets
# them as environment variables from the Kubernetes Secret ${PREFIX}-secrets. The demo sign-in code
# (APP_ACCESS_CODE) lives in the same Secret; `make k8s-access-code` prints it.
DB_BACKEND=mssql
DB_HOST=${PREFIX}-mssql
DB_PORT=1433
DB_NAME=iris
DB_UP_MODE=external
MSSQL_SA_USER=sa
MSSQL_APP_USER=iris_reader
ODBC_DRIVER=ODBC Driver 18 for SQL Server
MSSQL_TRUST_SERVER_CERT=yes
DUCKDB_PATH=data/iris.duckdb
LLM_MODEL=ollama/qwen2.5-coder:14b
OLLAMA_API_BASE=http://${PREFIX}-ollama:11434
LLM_TEMPERATURE=0
LLM_TIMEOUT_SECONDS=600
LLM_MODEL_CHOICES=ollama/qwen2.5-coder:14b,ollama/gpt-oss:20b
VERTEXAI_PROJECT=${GCP_PROJECT}
VERTEXAI_LOCATION=us-central1
DEFAULT_USER=group_cfo
