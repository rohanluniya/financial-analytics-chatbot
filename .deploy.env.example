# Copy to .deploy.env (gitignored) for the optional Kubernetes workflow (make k8s-*).
GCP_PROJECT=your-project-id
GKE_CLUSTER=your-cluster
GKE_REGION=us-central1
NAMESPACE=iris
PREFIX=iris
NODE_POOL=your-cpu-node-pool
# Absolute path; create it with:
#   KUBECONFIG=/abs/path/kubeconfig gcloud container clusters get-credentials $GKE_CLUSTER --region $GKE_REGION --project $GCP_PROJECT
KUBECONFIG_PATH=/absolute/path/to/kubeconfig
WS=/workspace/iris
